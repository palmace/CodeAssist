apply plugin: 'com.android.application'
apply plugin: 'kotlin-android'
apply plugin: 'kotlin-kapt'

android {
    namespace 'com.tyron.code'

    compileSdkVersion rootProject.ext.compileSdkVersion
    buildToolsVersion rootProject.ext.buildToolsVersion

    defaultConfig {
        applicationId rootProject.ext.applicationId
        minSdkVersion rootProject.ext.minSdkVersion
        targetSdkVersion rootProject.ext.targetSdkVersion
        versionCode rootProject.ext.versionCode
        versionName rootProject.ext.versionName

        testInstrumentationRunner "androidx.test.runner.AndroidJUnitRunner"
    }

    compileOptions {
        coreLibraryDesugaringEnabled = true
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
    }

    kotlinOptions {
        jvmTarget = '17'
        freeCompilerArgs += [
            "-Xskip-prerelease-check",
            "-Xjvm-default=all"
        ]
    }

    buildTypes {
        release {
            signingConfig signingConfigs.debug
            minifyEnabled false
            proguardFiles getDefaultProguardFile('proguard-android.txt'), 'proguard-rules.pro'
        }
    }

    packagingOptions {
        resources {
            excludes += [
                "license/*", "plugin.properties", "plugin.xml", "about.html", ".api_description",
                "about_files/*", "META-INF/eclipse.inf", "META-INF/INDEX.LIST", "META-INF/DEPENDENCIES",
                "META-INF/LGPL2.1", "META-INF/groovy-release-info.properties", "META-INF/AL2.0", "README.md",
                "META-INF/*.kotlin_module", "META-INF/*.version", "module-info.class", "META-INF/versions/*"
            ]
            pickFirsts += [
                "META-INF/sisu/*", "*/*.kotlin_builtins", "*/*/*.kotlin_builtins", "*/*/*/*.kotlin_builtins",
                "META-INF/gradle-plugins/*", "META-INF/services/*", "META-INF/io.netty.versions.properties"
            ]
        }
    }
}

configurations.configureEach {
    resolutionStrategy {
        force 'jakarta.activation:jakarta.activation-api:1.2.2'
        force 'jakarta.xml.bind:jakarta.xml.bind-api:2.3.3'
        force 'com.github.albfernandez:juniversalchardet:2.4.0'
        
        // FORZAR LSP4J PARA EVITAR DUPLICADOS
        force 'org.eclipse.lsp4j:org.eclipse.lsp4j:0.21.1'
        force 'org.eclipse.lsp4j:org.eclipse.lsp4j.jsonrpc:0.21.1'
        
        eachDependency { DependencyResolveDetails details ->
            if (details.requested.group == 'javax.activation' || details.requested.group == 'com.sun.activation') {
                details.useTarget 'jakarta.activation:jakarta.activation-api:1.2.2'
            }
            if (details.requested.group == 'javax.xml.bind') {
                details.useTarget 'jakarta.xml.bind:jakarta.xml.bind-api:2.3.3'
            }
            if (details.requested.group == 'com.googlecode.juniversalchardet') {
                details.useTarget 'com.github.albfernandez:juniversalchardet:2.4.0'
            }
        }
    }
    
    exclude group: 'org.codehaus.mojo', module: 'animal-sniffer-annotations'
    exclude group: 'com.googlecode.juniversalchardet', module: 'juniversalchardet'
    exclude group: 'javax.activation'
    exclude group: 'javax.xml.bind'
}

